---
interface Props {
  title: string;
  href?: string;
  hanzi?: string;
}

const { title, href, hanzi } = Astro.props;
---

<div class="flex justify-between gap-4 flex-wrap items-end">
  <h1 class="widget-title line-clamp-2">
    {title}
    {hanzi && <span class="hanzi">{hanzi}</span>}
  </h1>
  {
    href && (
      <a
        href={href}
        type="button"
        class="text-white bg-lantern-red shadow-scroll hover:brightness-110 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-md text-xs px-3 py-2 text-center inline-flex items-center transition"
      >
        More
        <svg
          class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"
          />
        </svg>
      </a>
    )
  }
</div>
<div
  aria-hidden="true"
  class="h-px bg-gradient-to-r from-red-700/40 via-red-700/15 to-transparent"
>
</div>
