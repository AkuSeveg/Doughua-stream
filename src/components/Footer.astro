---
import animeConfig from "@configs/animeConfig";
import CoffeIcon from "./icons/CoffeIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";

interface Props {
  navLinks: {
    _1: {
      title: string;
      href: string;
    }[];
    _2: {
      title: string;
      href: string;
      targetBlank?: boolean;
    }[];
  };
}

const {
  huastream: { siteName, logo },
} = animeConfig;
const { navLinks } = Astro.props;
---

<footer
  class="relative bg-white/90 dark:bg-zinc-950/90 backdrop-blur-md border-t border-red-900/15 dark:border-red-500/15 mt-12"
>
  <div
    aria-hidden="true"
    class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-red-700/60 to-transparent"
  >
  </div>
  <div class="container w-full py-10 lg:py-12">
    <div class="scroll-divider mb-8">
      <span class="hanzi">华 · 流</span>
    </div>
    <div class="lg:flex lg:justify-between gap-8">
      <div class="mb-6 lg:mb-0 max-w-[500px]">
        <a href={Astro.url.origin} class="flex items-center gap-3">
          <span
            class="inline-flex items-center justify-center w-9 h-9 rounded-md bg-lantern-red shadow-scroll"
          >
            <img src={logo} class="w-6" alt=`${siteName} Logo` />
          </span>
          <span
            class="self-center font-display text-2xl font-bold whitespace-nowrap text-red-800 dark:text-red-400"
            >{siteName}</span
          >
        </a>
        <p class="py-4 text-zinc-600 dark:text-zinc-400 leading-relaxed">
          This site does not store any files on our server, we are linked to the
          media which is hosted on 3rd party services.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-16">
        <ul
          class="flex flex-col gap-4 text-zinc-500 dark:text-zinc-400 font-medium"
        >
          {
            navLinks._1.map((link) => (
              <li>
                <a href={link.href} class="hover:underline max-w-min">
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
        <ul
          class="flex flex-col gap-4 text-zinc-500 dark:text-zinc-400 font-medium"
        >
          {
            navLinks._2.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.targetBlank ? "_blank" : ""}
                  class="hover:underline max-w-min"
                >
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div
      aria-hidden="true"
      class="my-8 h-px bg-gradient-to-r from-transparent via-red-700/40 to-transparent"
    >
    </div>
    <div class="sm:flex sm:items-center sm:justify-between gap-4">
      <span class="text-sm text-zinc-500 sm:text-center dark:text-zinc-400"
        >© {new Date().getFullYear()}
        <a href={Astro.url.origin} class="hover:text-red-700 dark:hover:text-red-400 transition-colors">{siteName}</a>
        — Curated by
        <span class="text-red-700 dark:text-red-400 font-semibold">Yoanz</span>.
        All Rights Reserved.
      </span>
      <div class="flex mt-4 sm:justify-center sm:mt-0">
        <a
          href="https://github.com/AkuSeveg/Doughua-stream"
          target="_blank"
          class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white ms-5"
        >
          <GithubIcon />
        </a>
        <a
          href="https://sociabuzz.com/huastream/tribe"
          target="_blank"
          class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white ms-5"
        >
          <CoffeIcon />
        </a>
      </div>
    </div>
  </div>
</footer>
